{
  "name": "@clawling/clawchat-plugin-install-cli",
  "version": "0.2.0",
  "description": "CLI for ClawChat plugin installation and updates.",
  "author": "CLAWLING PTE. LTD.",
  "homepage": "https://github.com/clawling/clawchat-plugin-install-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clawling/clawchat-plugin-install-cli.git"
  },
  "bugs": {
    "url": "https://github.com/clawling/clawchat-plugin-install-cli/issues"
  },
  "keywords": [
    "clawchat",
    "openclaw",
    "hermes",
    "plugin",
    "cli",
    "installer"
  ],
  "type": "module",
  "bin": {
    "clawchat": "dist/index.cjs"
  },
  "types": "dist/index.d.cts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release:dry": "pnpm typecheck && pnpm test && pnpm build && npm pack --dry-run"
  },
  "devDependencies": {
    "cac": "^6.7.14"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
